# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o Git.

# String de conexão do PostgreSQL (Supabase, Neon, Render, etc.)
# Exemplo Supabase: postgres://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Segredo usado para assinar os tokens JWT — gere uma string longa e aleatória.
# Pode gerar uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-uma-string-longa-e-aleatoria

# Porta em que a API vai rodar (a maioria dos serviços de hospedagem define
# isso automaticamente via variável de ambiente PORT — não precisa mexer)
PORT=3000

# URL(s) do frontend que podem acessar a API (separadas por vírgula).
# Em produção, coloque a URL exata do seu site (Vercel/Netlify/etc.)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
